
/* =========================================
   DISHUP! — STYLE.CSS
   Light blue edition
   ========================================= */

:root {
  color-scheme: light;
  --background: #eaf8ff;
  --surface: #ffffff;
  --primary: #129bd2;
  --primary-dark: #07577c;
  --border: #8cc8e4;
  --text: #12364b;
  --muted: #527c92;
  --button: #82d7f5;
  --button-hover: #50bfe9;
}

* {
  box-sizing: border-box;
}

body {
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: var(--background);
  color: var(--text);
  max-width: 980px;
  margin: 0 auto;
  padding: 85px 25px 35px;
  line-height: 1.5;
}

.hidden {
  display: none !important;
}

/* HEADER */

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 28px;
}

h1 {
  font-size: clamp(2.7rem, 6vw, 4rem);
  letter-spacing: -0.06em;
  line-height: 1;
  margin: 0;
}

header b {
  font-size: 13px;
  letter-spacing: 0.1em;
  color: var(--primary-dark);
}

h2 {
  letter-spacing: -0.025em;
  margin-top: 0;
}

/* PANELS */

.panel {
  background: var(--surface);
  border: 2px solid #277fa8;
  border-radius: 20px;
  padding: 28px;
  margin: 20px 0;
  box-shadow: 0 12px 36px #0a5b7b0d;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 14px;
  margin: 20px 0;
}

/* BUTTONS AND INPUTS */

button,
input,
select {
  font: inherit;
  border-radius: 10px;
  border: 1px solid var(--border);
  padding: 11px 13px;
}

button {
  cursor: pointer;
  background: var(--button);
  color: var(--text);
  font-weight: 750;
  transition: background 0.15s ease, transform 0.15s ease;
}

button:hover:not(:disabled) {
  background: var(--button-hover);
}

button:active {
  transform: scale(0.98);
}

button:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

button:focus-visible,
input:focus-visible,
select:focus-visible {
  outline: 3px solid var(--primary);
  outline-offset: 2px;
}

.grid button {
  min-height: 65px;
  text-align: center;
}

input[type="range"] {
  width: min(80%, 550px);
  vertical-align: middle;
  accent-color: var(--primary);
}

label {
  display: block;
  margin: 16px 0;
}

.muted {
  color: var(--muted);
}

/* LANGUAGE SELECTOR */

#languagePanel {
  position: fixed;
  top: 12px;
  left: 12px;
  z-index: 1000;
  background: white;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 7px 10px;
  box-shadow: 0 3px 12px #0001;
  font-size: 13px;
}

#languagePanel select {
  padding: 5px;
  background: var(--background);
}

/* SCOREBOARD */

#scoreBanner {
  position: fixed;
  top: 12px;
  right: 12px;
  z-index: 1000;
  background: var(--primary-dark);
  color: white;
  border-radius: 13px;
  padding: 10px 13px;
  box-shadow: 0 4px 18px #0003;
  max-width: 240px;
  font-size: 13px;
}

#scoreBanner .active {
  color: #a6edff;
  font-weight: 800;
}

/* GAME */

#status {
  font-weight: 750;
  color: var(--primary-dark);
}

#timer {
  font-size: 1.3rem;
  font-weight: 800;
  color: #087fab;
}

#food {
  font-size: 3rem;
}

#dishPhoto {
  display: none;
  width: 100%;
  max-width: 570px;
  height: 290px;
  object-fit: cover;
  border-radius: 15px;
  border: 2px solid #277fa8;
  background: #dff4fc;
  margin: 12px 0;
}

#photoCredit {
  font-size: 11px;
  color: var(--muted);
  margin: 0 0 12px;
}

/* WORLD MAP */

#mapAnswer {
  margin: 24px 0;
}

#mapLabel {
  display: block;
  font-size: 16px;
  margin-bottom: 10px;
}

#selectedCountry {
  display: inline-block;
  background: #dcf5ff;
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 8px 12px;
  color: var(--primary-dark);
  font-weight: 750;
  margin: 0 0 12px;
}

#worldMap {
  width: 100%;
  height: 390px;
  min-height: 390px;
  background: #dff4fc;
  border: 2px solid var(--border);
  border-radius: 15px;
  overflow: hidden;
  position: relative;
  z-index: 1;
}

#mapHelp {
  font-size: 13px;
  margin: 10px 0 0;
}

#originFallback {
  margin: 16px 0;
}

.leaflet-container {
  font-family: system-ui, sans-serif;
}

.leaflet-interactive:focus {
  outline: 2px solid #087fab;
}

/* HANDOFF AND RESULTS */

.handoff {
  background: #dcf5ff;
  border: 1px solid #78c5e5;
  border-radius: 12px;
  padding: 18px;
  margin: 16px 0;
}

.summary {
  border: 1px solid #a8d8ed;
  border-radius: 12px;
  padding: 14px;
  margin: 14px 0;
}

.summary h3 {
  margin: 0 0 8px;
}

.summary p {
  margin: 5px 0;
}

#results {
  margin-top: 16px;
}

#results p {
  padding: 8px;
  border-bottom: 1px solid #ddd;
}

/* FINAL RANKING */

.final-ranking {
  display: grid;
  gap: 8px;
  margin-bottom: 24px;
}

.rank-row {
  display: flex;
  justify-content: space-between;
  background: #dcf5ff;
  padding: 12px;
  border-radius: 10px;
}

.history-round {
  border: 1px solid #a8d8ed;
  border-radius: 12px;
  margin: 12px 0;
  background: #f5fcff;
  padding: 12px;
}

.history-round summary {
  cursor: pointer;
  font-weight: 750;
  display: flex;
  justify-content: space-between;
  gap: 8px;
}

.history-player {
  background: white;
  border-radius: 10px;
  padding: 12px;
  margin: 12px 0;
}

.history-player h4 {
  margin: 0 0 10px;
}

.history-scroll {
  overflow-x: auto;
}

.history-player table {
  border-collapse: collapse;
  width: 100%;
  font-size: 13px;
  text-align: left;
}

.history-player th,
.history-player td {
  padding: 8px;
  border-bottom: 1px solid #d7ebf5;
}

.history-player th {
  color: var(--primary-dark);
  background: var(--background);
}

#finish {
  padding-bottom: 30px;
}

/* DISCOVERY */

.discover {
  margin: 26px 0;
  padding: 22px;
  border-radius: 16px;
  background: var(--background);
  border: 1px solid #9bd7f0;
}

.dish-links {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 10px;
}

.dish-link {
  display: block;
  background: white;
  border: 1px solid #9bd7f0;
  border-radius: 12px;
  padding: 12px;
  color: var(--primary-dark);
  text-decoration: none;
  font-weight: 750;
}

.dish-link:hover {
  background: #ccefff;
}

#cityInput {
  max-width: 100%;
}

/* MOBILE */

@media (max-width: 600px) {
  body {
    padding: 85px 12px 24px;
  }

  .panel {
    padding: 17px;
    border-radius: 16px;
  }

  header {
    gap: 8px;
  }

  header b {
    font-size: 11px;
  }

  #languagePanel {
    top: 5px;
    left: 5px;
    padding: 5px;
    font-size: 11px;
  }

  #languagePanel select {
    padding: 4px;
  }

  #scoreBanner {
    top: 5px;
    right: 5px;
    max-width: 145px;
    font-size: 11px;
    padding: 7px;
  }

  #dishPhoto {
    height: 210px;
  }

  #worldMap {
    height: 310px;
    min-height: 310px;
  }

  .grid {
    grid-template-columns: 1fr;
  }

  .grid button {
    min-height: 55px;
  }

  .discover {
    padding: 15px;
  }
}
